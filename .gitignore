# Ignora todas as pastas de dependências do Node.js
node_modules/

# Ignora todos os arquivos de variáveis de ambiente (em qualquer pasta)
**/.env

# Arquivos de log e debug (opcional, mas recomendado)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pastas e arquivos locais do mantenedor (não versionados)
.cursor/rules/
AGENTS.local.md
_mantenedor/
_mantenedor/skills/

# Slides do curso (.pptx e PDFs): ficam só no local, não são publicados
modulo*/slides/

# Configurações de extensões
.codex
.claude/
.agents
.cursor

# Configurações do VSCODE
.vscode/

# Arquivo local de handoff
/HANDOFF.md
